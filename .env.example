# Kymora needs no API keys, no database and no server-side image handling.
# The pipeline runs entirely in the browser (and in Node for `npm run eval`).

# Data source behind lib/adapter.ts: "fake" (seeded synthetic strips) or "real".
# "real" is reserved for the PTB-XL fold 10 results (Phase 2) and falls back to fake until then.
ADAPTER_MODE=fake

# Set automatically by next.config.ts at build time from public/brand/*.png.
# Do not set it by hand; the empty value below only documents the key.
NEXT_PUBLIC_BRAND_FILES=
